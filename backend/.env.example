# backend/.env — config.py 가 읽는 런타임 환경변수 (v2 — WebRTC).
# 실제 값은 backend/.env 에만 (git 에 안 올림). 이 파일은 placeholder + 설명만.

# 허용 오리진 (CORS). 기본 "*" (모든 오리진)
CORS_ORIGINS=*

# 등록 가능한 IP 카메라 최대 대수 (1~64, 기본 16). 초과 시 POST 409
MAX_IPCAMS=16

# mediamtx API 주소. Docker 는 compose 가 프로젝트 전용 mediamtx 서비스 주소를 주입하고,
# native dev 는 루트 .env의 MEDIAMTX_API_PORT를 dev.sh가 loopback 주소로 치환한다.
# backend만 단독 실행할 때에만 여기에 host API 주소를 설정한다. 미설정이면 path 등록 실패.
MEDIAMTX_API=

# WebRTC 외부접속 광고 호스트 (공인 IP/도메인). webrtcAdditionalHosts 로 쓰임.
# 미설정이면 외부에서 영상이 안 나올 수 있음 (컨테이너 배포 #1 gotcha).
MEDIAMTX_WEBRTC_HOST=

# 로그 레벨 (기본 INFO)
LOG_LEVEL=
