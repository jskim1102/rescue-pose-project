# 모듈 루트 .env — docker-compose 가 읽는 포트 변수. 실제 값은 .env 에만
# (git 에 안 올림, RULES §4.1). 이 파일은 placeholder + 설명만. git 에 올림.
# add-cto 가 PORT_OFFSET/BACKEND_PORT/FRONTEND_PORT 를 .env 에 자동 기록한다.

# CTO 포트 offset (add-cto 자동배정)
PORT_OFFSET=
# backend HTTP port = 8000 + PORT_OFFSET (예: offset=8 → 8008), 컨테이너 8000
BACKEND_PORT=
# frontend port = 5174 + (PORT_OFFSET − 1) (예: offset=8 → 5181), 컨테이너 80
# 주의: offset=2(5175)·offset=5(8005)는 시스템 RESERVED — add-cto 가 자동 스킵
FRONTEND_PORT=

# ── DB — SQLite (base=rtsp-streaming, alembic 정본) ──
# DATABASE_URL 은 미설정 시 base database.py 의 SQLite 기본 경로 사용. docker-compose 가
# sqlite:////app/data/ipcam.db (named volume) 로 override. postgres 미사용(spec Decision).

# ── mediamtx — 공유 인스턴스 harness-shared-mediamtx 사용 (CEO #115) ──
# per-project mediamtx 제거 — 모든 모듈이 공유 인스턴스에 path-prefix 네임스페이싱으로 입주.
# 아래 값은 `harness mtx env rescue-pose` 출력으로 채운다(비번=infra/.env 공유값, 출력 금지).
# MEDIAMTX_API: compose=docker DNS(http://harness-shared-mediamtx:9997), 네이티브 dev=http://127.0.0.1:9997(dev.sh override).
MEDIAMTX_API=
# Detection 캡처용 RTSP fan-out base. 비우면 MEDIAMTX_API host 의 8554 포트로 자동 파생.
# compose=rtsp://harness-shared-mediamtx:8554, 네이티브 dev=rtsp://127.0.0.1:8554
MEDIAMTX_RTSP_BASE_URL=
# 쉼표구분 stream_key allowlist. 여기에 넣은 카메라는 detection 이 mediamtx fan-out 을 읽는다.
# sync_pose 자동 direct-camera 판정 카메라도 fan-out 을 읽으므로, 보통은 비워둔다.
MEDIAMTX_DETECTION_FANOUT_STREAM_KEYS=
# 쉼표구분 stream_key 강제 allowlist/denylist. 기본은 RTSP URL 자동분류:
# - NVR형(realmonitor/channel/subtype/Streaming/Channels/ISAPI) → 기존 WHEP+overlay
# - direct camera형(/camera01 등) → sync_pose
SYNCED_POSE_STREAM_KEYS=
SYNCED_POSE_DISABLED_STREAM_KEYS=
VITE_SYNCED_POSE_STREAM_KEYS=
# path 네임스페이스 prefix — stream_key 가 `<prefix>__ipcam-*` 로 생성/저장(프로젝트간 교차열람 차단).
MEDIAMTX_PATH_PREFIX=rescue_pose
# WebRTC(WHEP) 포트 — 브라우저 직접 접속(영상). 공유 인스턴스 8889. frontend 빌드 인라인용.
MEDIAMTX_WEBRTC_PORT=8889
# WebRTC ICE advertise 호스트(쉼표구분) — 브라우저가 닿을 LAN/공인 IP. 미설정이면 외부영상 안 나옴.
MEDIAMTX_WEBRTC_HOST=
# 공유 mediamtx 자격증명 (infra/.env 공유값). backend=API/publish/read, viewer=이 프로젝트 WHEP read 전용.
MEDIAMTX_BACKEND_USER=backend
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rescue_pose
MEDIAMTX_VIEWER_PASS=

# ── detection (YOLO 추론 — deepeye-lite 정본 기본값) ──
# YOLO_DEVICE 빈값 = 워커가 torch.cuda.is_available() 자동감지(GPU→cuda:0, 없으면 CPU 폴백).
# docker-compose.gpu.yml override 가 cuda:0 강제 + NVIDIA 패스스루.
YOLO_DEFAULT_MODEL=yolo26n-pose.pt
YOLO_CONF_THRESHOLD=0.5
YOLO_DEVICE=
# 추론 샘플 간격(초). resize-before-IPC(CEO #235) 로 추론 비용↓ → 0.033=~30fps 목표.
INFERENCE_INTERVAL=0.033
CAPTURE_INTERVAL=0.01
# 단일 inference 워커 지속 infer/s × 0.8 여유율; 활성캠수로 나눠 per-camera fps 자동 하향.
MAX_INFER_PER_SEC=65

# ── 선택(기본값 있음) ──
# 등록 카메라 cap (1~64, 기본 16). 백엔드 /api/config 로 프론트에 내려감.
MAX_IPCAMS=16
# CORS 허용 origin — 인증이 없으므로 공개배포 시 프론트 origin 으로 한정 권장(보안 P1-4).
# 예: http://<공인IP>:5181  (미설정 시 기본 "*" = 모든 origin 허용)
CORS_ORIGINS=*
