# 모듈 루트 .env — docker-compose 가 읽는 포트 변수. 실제 값은 .env 에만
# (git 에 안 올림, RULES §4.1). 이 파일은 placeholder + 설명만. git 에 올림.
# add-cto 가 PORT_OFFSET/BACKEND_PORT/FRONTEND_PORT 를 .env 에 자동 기록한다.

# CTO 포트 offset (add-cto 자동배정)
PORT_OFFSET=
# backend HTTP port = 8000 + PORT_OFFSET (예: offset=8 → 8008), 컨테이너 8000
BACKEND_PORT=
# frontend port = 5174 + (PORT_OFFSET − 1) (예: offset=8 → 5181), 컨테이너 80
# 주의: offset=2(5175)·offset=5(8005)는 시스템 RESERVED — add-cto 가 자동 스킵
FRONTEND_PORT=

# ── DB — SQLite (base=rtsp-streaming, alembic 정본) ──
# DATABASE_URL 은 미설정 시 base database.py 의 SQLite 기본 경로 사용. docker-compose 가
# sqlite:////app/data/ipcam.db (named volume) 로 override. postgres 미사용(spec Decision).

# ── mediamtx — 프로젝트 전용 self-host 인스턴스 ──
# 컨테이너 내부 주소. native dev 는 dev.sh 가 host offset 포트로 치환한다.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_RTSP_BASE_URL=rtsp://mediamtx:8554
# host publish 포트 — 실제 값은 .env 에만. 각 값은 RULES §4의 base + PORT_OFFSET.
MEDIAMTX_API_PORT=
MEDIAMTX_RTSP_PORT=
MEDIAMTX_WEBRTC_PORT=
MEDIAMTX_ICE_UDP_PORT=
# path 네임스페이스 prefix — stream_key 가 `<prefix>__ipcam-*` 로 생성/저장(프로젝트간 교차열람 차단).
MEDIAMTX_PATH_PREFIX=rescue_pose
# WebRTC ICE advertise 호스트(쉼표구분) — 브라우저가 닿을 LAN/공인 IP. 미설정이면 외부영상 안 나옴.
MEDIAMTX_WEBRTC_HOST=
# 프로젝트별 고유 자격증명. backend=API/publish/read, viewer=이 프로젝트 WHEP read 전용.
MEDIAMTX_BACKEND_USER=backend
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rescue_pose
MEDIAMTX_VIEWER_PASS=

# ── detection (YOLO 추론 — deepeye-lite 정본 기본값) ──
# YOLO_DEVICE 빈값 = 워커가 torch.cuda.is_available() 자동감지(GPU→cuda:0, 없으면 CPU 폴백).
# docker-compose.gpu.yml override 가 cuda:0 강제 + NVIDIA 패스스루.
YOLO_DEFAULT_MODEL=yolo26n-pose.pt
YOLO_CONF_THRESHOLD=0.5
YOLO_DEVICE=
# 캡처 cadence·모델 lane batch·추론 해상도는 telemetry로 자동 조절한다.
# 최대 GPU duty target은 API/UI/백엔드에서 95%로 제한된다.

# ── 선택(기본값 있음) ──
# 등록 카메라 cap (1~64, 기본 16). 백엔드 /api/config 로 프론트에 내려감.
MAX_IPCAMS=2
# CORS 허용 origin — 인증이 없으므로 공개배포 시 프론트 origin 으로 한정 권장(보안 P1-4).
# 예: http://<공인IP>:5181  (미설정 시 기본 "*" = 모든 origin 허용)
CORS_ORIGINS=*
